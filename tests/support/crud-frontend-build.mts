// A frontend generated by the CRUD builds (frontbuilder b2fe7ad: the build refuses a link to a missing Page,
// FLOW_PAGE_LINK_UNKNOWN). Its links (navigation, home, entity list, detail and form pages, row actions) target the Pages
// it writes, and the links of ui.navigation the Pages written next to them; every generated page compiles.
import assert from 'node:assert/strict';
import test from 'node:test';
import {mkdtemp,mkdir,writeFile,readFile,rm} from 'node:fs/promises';
import {readFileSync} from 'node:fs';
import {tmpdir} from 'node:os';
import {dirname,join,resolve} from 'node:path';
import {pathToFileURL} from 'node:url';
import {createRequire} from 'node:module';
import vm from 'node:vm';
const provider=process.env.FLOW_FRONTBUILDER_RESOURCE_ROOT!;
const engine=process.env.FLOW_ENGINE_RESOURCE_ROOT!;
const {loadDocument}=await import(pathToFileURL(resolve(provider,'src-builder/frontDocument.ts')).href);
const {generateSvelteProject}=await import(pathToFileURL(resolve(provider,'src-builder/generateSvelteProject.ts')).href);
const {compile}=createRequire(resolve(provider,'package.json'))('svelte/compiler');
const load=(name:string)=>vm.runInNewContext(readFileSync(resolve(import.meta.dirname,'../../_flow/lib',name+'.js'),'utf8'));
const services={model:load('crud-model'),legacy:load('crud-legacy'),ui:load('crud-ui')},crud=load('crud-fastpath');
const project='CrudBuild',routes='_flow/frontbuilder/svelte/model/'+project+'/src/routes/';
const entities=[
 {name:'clients',fields:[{name:'Id',type:'INTEGER',primary:true},{name:'Name',type:'VARCHAR(80)',required:true}]},
 {name:'tickets',fields:[{name:'Id',type:'INTEGER',primary:true},{name:'Title',type:'VARCHAR(80)',required:true},{name:'ClientId',type:'INTEGER',references:'clients'}]}
];
// A Page written next to the generated ones, which ui.navigation links.
const handWritten=(id:string,title:string)=>['<script module>','export const _flow = { sourceVersion: 2, page: { id: '+JSON.stringify(id)+', title: '+JSON.stringify(title)+' } };','</script>',
 '<FlowComponent $$id='+JSON.stringify(id)+'>','<Structure><PageHeader $$id="header" title='+JSON.stringify(title)+' /></Structure>','</FlowComponent>',''].join('\n');

async function build(t:any,spec:any,extra:Record<string,string>={}){
 const compiled=crud.compile(spec,project,services);
 const root=await mkdtemp(join(tmpdir(),'flow-crud-build-'));t.after(()=>rm(root,{recursive:true,force:true}));
 const files={...compiled.files,...extra};
 for(const [file,code] of Object.entries(files)){
  if(!/^_flow\/frontbuilder\//.test(file))continue;
  const path=join(root,file);await mkdir(dirname(path),{recursive:true});await writeFile(path,String(code));
 }
 const doc=await loadDocument(join(root,routes+'+page.flow.svelte'),{},{resourceRoot:provider,projectRoot:root,projectName:project,referenceRoots:[resolve(engine,'..')],discoverImplicitProviders:false});
 assert.deepEqual(doc.diagnostics.filter((d:any)=>d.level==='error'&&!/REQUESTABLE|CALL_CONTRACT|UNKNOWN_FLOW/.test(String(d.code))),[]);
 const built=await generateSvelteProject(root,doc.model,{resourceRoot:provider});
 for(const page of doc.model.app.pages){
  const route=String(page.route||'/').replace(/^\/+|\/+$/g,'');
  const code=await readFile(join(built.generatedRoot,'src/routes/'+(route?route+'/':'')+'+page.svelte'),'utf8');
  assert.doesNotThrow(()=>compile(code,{filename:page.id+'.svelte',generate:'client'}),page.id);
 }
 return {compiled,doc};
}

test('a CRUD frontend builds, its links on the pages it writes',async t=>{
 const {compiled,doc}=await build(t,{facade:{prefix:'desk'},security:{principals:{ada:'agent'}},entities});
 const pages=new Set(doc.model.app.pages.map((page:any)=>page.id));
 for(const page of String(Object.values(compiled.files).join('\n')).matchAll(/\bpage="([A-Za-z_][\w]*)"/g)) assert.ok(pages.has(page[1]),'generated link to '+page[1]);
});

test('a CRUD frontend with ui.navigation builds once its Pages are written',async t=>{
 const spec={facade:{prefix:'desk'},security:{principals:{ada:'agent',max:'manager'}},entities,
  ui:{navigation:[{page:'my_tickets',label:'My tickets'},{page:'team_report',label:'Report',permission:'tickets.delete'}]}};
 await build(t,spec,{[routes+'my-tickets/+page.flow.svelte']:handWritten('my_tickets','My tickets'),[routes+'team-report/+page.flow.svelte']:handWritten('team_report','Report')});
});
