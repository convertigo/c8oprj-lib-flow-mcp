          "revision": "1"
        }
      ],
      "employees": [
        {
          "id": "1",
          "name": "Ada Lovelace",
          "companyId": "1",
          "revision": "1"
        },
        {
          "id": "2",
          "name": "Grace Hopper",
          "companyId": "2",
          "revision": "1"
        }
      ]
    }
  }
