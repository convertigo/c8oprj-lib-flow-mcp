{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:convertigo:flow-crud:legacy-model:1",
  "title": "Stored Flow data model compatible with legacy CRUD",
  "type": "object",
  "required": [
    "entities"
  ],
  "additionalProperties": true,
  "properties": {
    "project": {
      "type": "string"
    },
    "modelVersion": {
      "const": 1,
      "description": "Optional format version extension."
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Optional schema revision; omitted versions are assigned from the applied schema."
    },
    "database": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "mode": {
          "enum": [
            "hsqldb",
            "postgresql",
            "mariadb",
            "mysql",
            "sqlserver",
            "oracle"
          ]
        },
        "connector": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": [
            "integer",
            "string"
          ]
        },
        "database": {
          "type": "string"
        },
        "user": {
          "type": "string"
        },
        "password": {
          "type": "string",
          "description": "Legacy inline credentials parse unchanged but block persistence/application; use a server secret reference."
        },
        "connection": {
          "type": "string",
          "description": "Optional Flow named connection."
        },
        "schema": {
          "type": "string"
        },
        "schemaPolicy": {
          "enum": [
            "managed",
            "observe"
          ],
          "default": "managed",
          "description": "observe forbids DDL and seeding; application data access remains separately authorized."
        }
      }
    },
    "facade": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "prefix": {
          "type": "string"
        }
      }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "fields"
        ],
        "additionalProperties": true,
        "properties": {
          "name": {
            "type": "string"
          },
          "singular": {
            "type": "string"
          },
          "plural": {
            "type": "string"
          },
          "routeSegment": {
            "type": "string"
          },
          "displayLabel": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "name"
              ],
              "additionalProperties": true,
              "properties": {
                "name": {
                  "type": "string"
                },
                "column": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "description": "Legacy SQL type, translated losslessly to the portable SQL model. Unsupported runtime types block application."
                },
                "label": {
                  "type": "string"
                },
                "primary": {
                  "type": [
                    "boolean",
                    "string",
                    "number"
                  ],
                  "description": "Legacy flags are normalized with the legacy boolean conversion; prefer JSON booleans."
                },
                "generated": {
                  "type": [
                    "boolean",
                    "string",
                    "number"
                  ],
                  "description": "Legacy flags are normalized with the legacy boolean conversion; prefer JSON booleans."
                },
                "unique": {
                  "type": [
                    "boolean",
                    "string",
                    "number"
                  ],
                  "description": "Legacy flags are normalized with the legacy boolean conversion; prefer JSON booleans."
                },
                "required": {
                  "type": [
                    "boolean",
                    "string",
                    "number"
                  ],
                  "description": "Legacy flags are normalized with the legacy boolean conversion; prefer JSON booleans."
                },
                "default": {},
                "references": {
                  "type": [
                    "string",
                    "object"
                  ]
                },
                "enum": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 128,
                  "uniqueItems": true,
                  "items": {
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  },
                  "description": "Optional common-format extension: scalar allowed values, validated by generated server writes. UI labels remain in ui.fieldOptions."
                }
              }
            }
          },
          "ui": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "listFields": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "detailFields": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "formFields": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "permissions": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "list": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "const": false
                  }
                ]
              },
              "read": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "const": false
                  }
                ]
              },
              "count": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "const": false
                  }
                ]
              },
              "create": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "const": false
                  }
                ]
              },
              "update": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "const": false
                  }
                ]
              },
              "save": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "const": false
                  }
                ]
              },
              "delete": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "const": false
                  }
                ]
              }
            }
          },
          "revision": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional column for optimistic concurrency. Omitted/null explicitly permits unversioned data writes."
          },
          "indexes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "columns"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "columns": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                "unique": {
                  "type": "boolean",
                  "default": false
                }
              }
            },
            "description": "Preserved common-format extension. This prototype refuses application until generic SQL index planning is available."
          },
          "rowPolicy": {
            "type": "object",
            "description": "Reserved future server policy. Any use currently blocks application."
          },
          "readOnly": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "description": "Legacy long/short relation declarations; field.references also supported."
      }
    },
    "seed": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": [
            "boolean",
            "string",
            "number"
          ],
          "description": "Legacy flags are normalized with the legacy boolean conversion; prefer JSON booleans."
        },
        "reset": {
          "type": [
            "boolean",
            "string",
            "number"
          ],
          "description": "Legacy flags are normalized with the legacy boolean conversion; prefer JSON booleans."
        },
        "profile": {
          "type": "string"
        },
        "rowsPerEntity": {
          "type": [
            "integer",
            "string"
          ]
        },
        "data": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "listFields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "detailFields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "formFields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": true,
      "description": "Optional Flow authentication integration; principals/demoLogin are prototype bindings only."
    },
    "origin": {
      "type": "object",
      "additionalProperties": true,
      "description": "Reserved import provenance (jdbc or xlsx), no importer or network operation is implemented."
    }
  }
}
